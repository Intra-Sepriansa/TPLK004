{
    "typescript.autoClosingTags": false,
    "php.validate.enable": false,
    "php.suggest.basic": false,
    "php.version": "8.4",
    "intelephense.environment.phpVersion": "8.4.0",
    "intelephense.diagnostics.argumentCount": false,
    "intelephense.diagnostics.duplicateSymbols": false,
    "intelephense.diagnostics.typeErrors": false,
    "intelephense.diagnostics.returnTypeMatch": false,
    "intelephense.diagnostics.implementationErrors": false,
    "intelephense.diagnostics.undefinedClassConstants": false,
    "intelephense.diagnostics.undefinedMethods": false,
    "intelephense.diagnostics.undefinedTypes": false,
    "intelephense.files.exclude": [
        "**/.git/**",
        "**/.svn/**",
        "**/.hg/**",
        "**/CVS/**",
        "**/.DS_Store/**",
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/*.blade.php",
        "**/.history/**",
        "**/storage/framework/**",
        "**/storage/logs/**",
        "**/_ide_helper.php",
        "**/_ide_helper_models.php",
        "**/.phpstorm.meta.php"
    ],
    "files.associations": {
        "*.blade.php": "blade"
    },
    "java.configuration.updateBuildConfiguration": "interactive"
}